# Copy to .env before `docker compose up`.
#
#   cp .env.example .env
#   # then replace JWT_SECRET with a real one:
#   openssl rand -base64 48

# ─── secrets ─────────────────────────────────────────────────────────────────

# Signing key for access tokens. There is deliberately no default in the API —
# a default JWT secret is a backdoor that ships to production exactly once and
# is never noticed. At least 32 characters.
JWT_SECRET=change-me-to-at-least-32-random-characters-before-use

# Encrypts TOTP secrets at rest, so a database dump is not a box of working
# second factors. Must be 32 bytes, base64-encoded:
#   openssl rand -base64 32
# Optional: leave unset and MFA enrolment is refused rather than done insecurely.
MFA_SECRET_KEY=

# ─── data stores ─────────────────────────────────────────────────────────────

# Local-development values; nothing here should ever be a real credential, and
# .env is gitignored so it cannot become one by accident.
POSTGRES_USER=carebridge
POSTGRES_PASSWORD=carebridge-local-dev
POSTGRES_DB=carebridge

# Used by the API when it runs on the host rather than in the compose network.
DATABASE_URL=postgresql://carebridge:carebridge-local-dev@127.0.0.1:55432/carebridge?schema=public

# Queues, live location, idempotency and rate limiting. Leave it unset and the
# API falls back to an in-process scheduler — correct for a single developer
# machine, wrong for anything with two instances. It says so at boot.
REDIS_URL=redis://127.0.0.1:56379

# ─── ports on the host ───────────────────────────────────────────────────────

WEB_PORT=8080
# The dispatch console, on its own origin. Separate from the family app on
# purpose — see the `ops` service in docker-compose.yml.
OPS_PORT=8081
API_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=56379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── behaviour ───────────────────────────────────────────────────────────────

# Loads the fictional demo family on start. Idempotent — safe to leave on.
# Set to false for a genuinely empty database.
SEED_ON_START=true

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# How many proxies sit in front of the API. The compose stack has one (nginx),
# so the client address comes from X-Forwarded-For rather than the socket —
# without this every per-IP limit below is keyed on the proxy and the whole
# internet shares one bucket. Set 0 when nothing is in front; never set it
# higher than the number of proxies actually there, or a caller can forge the
# header and get a fresh bucket per request.
TRUST_PROXY_HOPS=1

# Rate limits on the endpoints an unauthenticated caller can reach. Every one
# of these is a default — set them only to tune, not to make things work.
#
# Sign-in: failed attempts per email+IP before that pair is locked out, and a
# looser ceiling on attempts from one IP whatever address they name.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
SIGN_IN_IP_MAX_ATTEMPTS=30

# Registration, verification resend and password reset all send mail to an
# address the caller names. Counted per IP and per address, so neither one host
# mailing many people nor many hosts mailing one person gets through.
EMAIL_DISPATCH_MAX_ATTEMPTS=5
EMAIL_DISPATCH_WINDOW_MINUTES=60

# Guesses at a single-use secret: verification, reset, invitation, MFA code.
TOKEN_GUESS_MAX_ATTEMPTS=10
TOKEN_GUESS_WINDOW_MINUTES=15

# Without REDIS_URL these counters live in one process, so with more than one
# API instance the effective limit multiplies. The API says so at boot, and
# production refuses to start without Redis.

# Same-origin through the nginx proxy makes this irrelevant for the Docker
# stack; it matters when you run `flutter run -d chrome` against the API.
# Never "*" in production — the API refuses to start if it is.
CORS_ORIGINS=*

NODE_ENV=development
LOG_LEVEL=debug

# Where a verification or invitation link points. Deep links in the app, a web
# fallback here.
PUBLIC_APP_URL=http://localhost:8080

# ─── outbound adapters ───────────────────────────────────────────────────────
# Every vendor sits behind an interface, and every interface has a local
# adapter that needs no account. `log` prints what would have been sent.

# smtp | log        — smtp points at Mailpit locally and SES in production
MAIL_DRIVER=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=CareBridge <no-reply@carebridge.local>

# fcm | log
PUSH_DRIVER=log
# Service-account JSON for FCM HTTP v1, as a single line. Production injects
# this from Secrets Manager; it must never be committed.
FCM_SERVICE_ACCOUNT_JSON=

# deterministic | google
#
# Covers geocoding *and* routing. The deterministic adapter derives stable,
# plausible coordinates from the address text and answers a route with a
# straight line at a conservative city average — no key, no network, no
# per-run drift, so a result is reproducible in a test and identical on every
# machine. Its route is deliberately the same estimate the product falls back
# to when a real vendor is unreachable, so running without a key shows the
# degraded answer rather than a fictional traffic-aware one.
#
# Refused in production: a geocoder that invents confident coordinates would
# send a driver to a plausible wrong address.
MAPS_DRIVER=deterministic
MAPS_API_KEY=

# local | stripe
#
# The local adapter moves no money and decides each outcome from the card's
# last four digits, using Stripe's own test-card meanings — so a decline and
# the dunning that follows it can be reproduced on a laptop with no account:
#
#   ...4242  settles
#   ...9995  declined, insufficient funds  (retried on the dunning schedule)
#   ...9979  reported stolen               (terminal — no further attempts)
#   ...0069  expired card                  (retryable)
#   ...0341  needs authentication          (left pending for the webhook)
#
# Refused in production, and it is the most consequential of those refusals:
# an adapter that reports every charge as settled is a system that bills
# nobody and says everything is fine.
PAYMENTS_DRIVER=local
STRIPE_SECRET_KEY=
# Verifies that a "payment succeeded" callback actually came from Stripe.
# Required whenever PAYMENTS_DRIVER=stripe — without it the webhook endpoint,
# which is public by necessity, would accept anyone's word for it.
STRIPE_WEBHOOK_SECRET=

# Signs the local adapter's own webhooks, so the signature check is exercised
# in development rather than only in production. Protects nothing real.
PAYMENTS_WEBHOOK_SECRET=local-webhook-secret

# ─── live tracking ───────────────────────────────────────────────────────────
#
# There is no driver to set. The position store follows REDIS_URL: with it, a
# Redis key whose TTL is the domain's own `lostMs` plus pub/sub so every
# instance sees every report; without it, a map inside one process — which is
# correct on a laptop and wrong the moment there are two instances, because a
# family connected to one would never see a car reporting to the other. That is
# one of the reasons REDIS_URL is required in production.
#
# The gateway is mounted under /api/v1/socket.io, so nginx's existing /api
# proxy carries it and the browser stays same-origin.

# How long an invoice may sit open before the first charge is attempted.
# Zero is what a renewal wants; a pilot may want a delay.
INVOICE_DUE_HOURS=0

# How far ahead of an appointment its reminders fire, in minutes, ordered.
APPOINTMENT_REMINDER_OFFSETS=1440,120

