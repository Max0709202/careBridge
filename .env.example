# CareBridge environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; this file is
# not, so it must never contain a real value. Placeholder names only.
#
# Every integration below is OPTIONAL in development. When credentials are
# absent, the app falls back to a local development adapter that logs a safe,
# redacted message instead of contacting a third party. Nothing is sent
# anywhere real unless you deliberately configure it.
#
# Validated by src/lib/env/schema.ts. A missing required variable fails at
# startup with the variable name - never its value.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Deployment tier: development | test | staging | production
APP_ENV=development
# Public base URL. Inlined into the browser bundle.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CareBridge
# debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Supabase (Phase 2)
# ---------------------------------------------------------------------------
# Project URL and anon key are public by design; Row Level Security is what
# protects the data. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security entirely. Server-side only, and only in
# code paths that have already performed their own authorization check.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Postgres connection string used by Drizzle for migrations and
# server-side queries.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Payments - Stripe (Phase 6)
# ---------------------------------------------------------------------------
# SECRET. Use a TEST-mode key (sk_test_...). Leave blank to use the mock
# payment adapter.
STRIPE_SECRET_KEY=
# SECRET. Required whenever STRIPE_SECRET_KEY is set: without it webhook
# signatures cannot be verified, and an unverified webhook is untrusted input.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMS - Twilio (Phase 6)
# ---------------------------------------------------------------------------
# Leave blank to log messages locally instead of sending them.
TWILIO_ACCOUNT_SID=
# SECRET.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Email - Resend (Phase 6)
# ---------------------------------------------------------------------------
# SECRET. Leave blank to log emails locally instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Error reporting - Sentry (Phase 7)
# ---------------------------------------------------------------------------
# Both blank keeps error reporting disabled; errors still reach the server log.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
