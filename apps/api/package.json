{
  "name": "@carebridge/api",
  "version": "0.2.0",
  "description": "CareBridge API — NestJS modular monolith over PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "seed:prod": "node dist/prisma/seed.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "openapi:emit": "ts-node scripts/emit-openapi.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/websockets": "11.2.8",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "bullmq": "5.34.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.4.2",
    "luxon": "3.5.0",
    "nodemailer": "10.2.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@carebridge/eslint-config": "workspace:*",
    "@carebridge/typescript-config": "workspace:*",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.0",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.4.2",
    "@types/node": "22.10.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.2",
    "eslint": "9.39.1",
    "jest": "30.4.2",
    "pino-pretty": "13.0.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
