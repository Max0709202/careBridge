// CareBridge — data model.
//
// Mirrors lib/domain/models.dart, with the same two deliberate absences carried
// through to the database: no date of birth anywhere, and no clinical field
// anywhere. `ageBand` is coarse by design and `AppointmentType` is a
// coordination label, never a condition. See docs/FOUNDATION.md §6 and §9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── identity ────────────────────────────────────────────────────────────────

/// Standing inside CareBridge itself, as distinct from inside a customer's
/// organisation.
///
/// `OrgRole` says what somebody may do at the transport operator that employs
/// them. This says whether they work for the platform, and it is deliberately
/// a different axis: an operator's owner has complete authority over their own
/// company and none at all over anybody else's, while support has a narrow
/// read-only view across all of them.
enum PlatformRole {
  /// Everybody. The overwhelming majority of accounts.
  none
  /// Read the audit log and the operational dashboard. No writes anywhere.
  support
  /// The above, plus refunds and feature flags.
  admin
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullName     String
  phone        String?

  /// Almost always `none`. Granted out of band — there is deliberately no
  /// endpoint that promotes an account, because an endpoint that can create a
  /// platform administrator is the single most valuable thing in the system to
  /// find a flaw in.
  platformRole PlatformRole @default(none)

  /// Null until the address is proven. Nothing is blocked on it in the MVP —
  /// locking a family out of a ride they have already booked because a
  /// verification email went to spam is a worse outcome than an unverified
  /// address — but every invitation and access grant checks it.
  emailVerifiedAt DateTime?

  /// IANA zone, e.g. "America/New_York". Reminder scheduling is computed in
  /// it, so "the day before at 6pm" means the user's evening and not the
  /// server's. A UTC offset would be wrong twice a year.
  timeZone String @default("America/New_York")
  locale   String @default("en-US")

  /// Bumped by "sign out everywhere" and by a password change. Access tokens
  /// carry the version they were minted with, so raising it invalidates every
  /// token already in the wild without waiting for it to expire.
  tokenVersion Int @default(0)

  /// UI preferences, persisted per account so a browser refresh or a new device
  /// lands the user back where they were.
  selectedPatientId String?
  simplifiedMode    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens           RefreshToken[]
  access                  PatientAccess[]
  notifications           Notification[]
  consents                UserConsent[]
  credentialTokens        CredentialToken[]
  mfaEnrolment            UserMfa?
  deviceTokens            DeviceToken[]
  notificationPreferences NotificationPreference[]
  invitationsSent         PatientInvitation[]      @relation("InvitationInviter")
  invitationsAccepted     PatientInvitation[]      @relation("InvitationAcceptor")
  idempotencyRecords      IdempotencyRecord[]
  memberships             OrganizationMembership[]
  billingAccount          BillingAccount?
  seatChanges             SeatLedgerEntry[]
  driversApproved         Driver[]                 @relation("DriverApprover")
  driverProfile           Driver?                  @relation("DriverAccount")
  documentsReviewed       DriverDocument[]         @relation("DocumentReviewer")
  refundsRequested        Refund[]                 @relation("RefundRequester")
  flagsChanged            FeatureFlag[]            @relation("FlagEditor")
  caregiverProfile        Caregiver?               @relation("CaregiverAccount")
  bookingsRequested       CaregiverBooking[]       @relation("BookingRequester")
  reviewsWritten          CaregiverReview[]        @relation("ReviewAuthor")
  disputesRaised          BookingDispute[]         @relation("DisputeRaiser")
  disputesResolved        BookingDispute[]         @relation("DisputeResolver")

  @@map("users")
}

// ─── organisations ───────────────────────────────────────────────────────────

/// `clinicNetwork` exists as a value and nothing reads it yet: the clinic
/// portal is Stage 5B. Naming the axis now is what stops a second, parallel
/// "company" table being invented when it lands.
enum OrganizationKind {
  dispatchCompany
  clinicNetwork
}

/// A transport operator — the *second* paying party in the product.
///
/// Until the fee model became two-sided this table did not exist, and the
/// dispatch company was an implicit thing outside the system that supplied
/// drivers. It cannot be implicit once it holds a subscription: somebody has
/// to be billed, somebody has to be able to sign in and see the invoice, and
/// the seats have to belong to something.
model Organization {
  id   String           @id @default(uuid())
  kind OrganizationKind @default(dispatchCompany)
  name String

  /// Stable, human-typeable. Used in URLs and in support conversations, where
  /// reading a UUID down a telephone line is nobody's idea of a good time.
  slug String @unique

  contactEmail String
  phone        String?

  /// IANA zone. An operator's business day, dispatch shifts and invoice dates
  /// are theirs, not the server's.
  timeZone String @default("America/New_York")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships    OrganizationMembership[]
  drivers        Driver[]
  vehicles       Vehicle[]
  clinics        Clinic[]
  billingAccount BillingAccount?
  settledRides   Ride[]

  @@map("organizations")
}

enum OrgRole {
  owner
  admin
  dispatcher
  member
}

/// Many-to-many on purpose: a user may belong to several organisations.
///
/// That single decision is what keeps a later multi-tenant model from being a
/// rewrite of every query, and it costs nothing today — see
/// docs/architecture/multi-tenancy.md.
model OrganizationMembership {
  id             String  @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole @default(member)

  invitedByUserId String?
  joinedAt        DateTime  @default(now())
  /// Revoked rather than deleted: who could see the dispatch queue last March
  /// is an answer an investigation needs.
  revokedAt       DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, revokedAt])
  @@map("organization_memberships")
}

// ─── single-use credentials ──────────────────────────────────────────────────

enum CredentialTokenType {
  emailVerification
  passwordReset
}

/// Email verification and password reset, in one table because they are the
/// same object with a different purpose: a single-use, expiring, hashed
/// secret sent to an address.
///
/// Stored as a SHA-256 digest, never in plaintext. These are high-entropy
/// random values, not human-chosen passwords, so there is no dictionary for an
/// attacker to work against and argon2's cost would buy nothing — but a
/// database dump must not hand over a working set of password-reset links.
model CredentialToken {
  id        String              @id @default(uuid())
  userId    String
  type      CredentialTokenType
  tokenHash String              @unique

  /// The address the token was issued *for*. A reset link stays bound to the
  /// address that requested it, so changing the account email mid-flight
  /// cannot redirect a live reset to a new inbox.
  email String

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("credential_tokens")
}

// ─── multi-factor authentication ─────────────────────────────────────────────

/// TOTP enrolment. Scaffolding in Stage 2 (FOUNDATION §5): the enrol/verify
/// round trip and the storage are real, enforcement for staff and admin roles
/// arrives with those roles.
///
/// The shared secret is encrypted at rest with AES-256-GCM under
/// MFA_SECRET_KEY, which lives in Secrets Manager and not in this database.
/// A stolen dump is then a box of ciphertext rather than a box of working
/// second factors.
model UserMfa {
  userId String @id

  secretCiphertext Bytes
  secretIv         Bytes
  secretAuthTag    Bytes

  /// Enrolment is not complete until one code has been verified. Marking it
  /// enabled at the moment the QR code is shown would lock out anyone whose
  /// authenticator app failed to scan it.
  confirmedAt DateTime?

  /// Single-use, hashed, and the only way back in when the phone is gone.
  recoveryCodeHashes String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// Opaque refresh tokens, stored only as a hash.
///
/// `familyId` groups every token descended from one login. Presenting a token
/// that has already been rotated revokes the whole family — the standard
/// detection for a stolen refresh token, since the legitimate client and the
/// thief cannot both hold the newest one.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  /// What the session list shows. A person recognises "iPhone · Safari · last
  /// used 10 minutes ago" and can act on it; they cannot act on a token id.
  /// Carried forward across rotation so a session keeps one identity for its
  /// whole life rather than appearing to be a new device every fifteen
  /// minutes.
  deviceLabel String?
  ip          String?
  lastUsedAt  DateTime @default(now())

  /// Why it ended. Distinguishes a deliberate sign-out from the automatic
  /// family-wide revocation that reuse detection triggers — which is a
  /// security event a user should be told about, not a routine logout.
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum ConsentType {
  terms
  privacy
  locationSharing
  notifications
}

/// Append-only. Consent is recorded, never inferred from use of the app.
model UserConsent {
  id              String      @id @default(uuid())
  userId          String
  type            ConsentType
  documentVersion String
  acceptedAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
}

// ─── shared value objects ────────────────────────────────────────────────────

/// Rows are owned by whatever references them. A ride's pickup and destination
/// are **snapshots** taken at request time — copied, not shared — so that a
/// patient moving house never rewrites where a completed ride actually went.
model Address {
  id          String  @id @default(uuid())
  label       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  accessNotes String?
  latitude    Float?
  longitude   Float?

  /// How much to trust the pin, and where it came from.
  ///
  /// `approximate` means we located the postcode and not the building: the UI
  /// must not draw a confident marker, and a driver needs `accessNotes` more
  /// than usual. Recorded because a wrong pin is a support conversation, and
  /// "which geocoder produced this, and did it claim rooftop accuracy" is the
  /// first question in it.
  geocodePrecision String?
  geocodeSource    String?
  geocodedAt       DateTime?

  patientHomes     Patient[]
  clinics          Clinic[]
  ridePickups      Ride[]    @relation("RidePickup")
  rideDestinations Ride[]    @relation("RideDestination")

  @@map("addresses")
}

// ─── patients and family access ──────────────────────────────────────────────

enum AgeBand {
  under65
  from65to74
  from75to84
  over85
}

enum MobilityNeed {
  walker
  wheelchair
  cane
  oxygen
  transferAssistance
  escortToDoor
  lowVision
  hardOfHearing
  memorySupport
}

model Patient {
  id            String  @id @default(uuid())
  preferredName String
  legalName     String?
  phone         String
  homeAddressId String

  ageBand           AgeBand?
  preferredLanguage String         @default("English")
  mobilityNeeds     MobilityNeed[]
  mobilityNotes     String?
  preferredClinicId String?

  /// Soft delete: audit and dispute resolution need the record to survive.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeAddress       Address             @relation(fields: [homeAddressId], references: [id])
  emergencyContacts EmergencyContact[]
  access            PatientAccess[]
  appointments      Appointment[]
  rides             Ride[]
  invitations       PatientInvitation[]
  careBookings      CaregiverBooking[]

  @@map("patients")
}

model EmergencyContact {
  id           String  @id @default(uuid())
  patientId    String
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("emergency_contacts")
}

enum FamilyPermission {
  viewProfile
  scheduleAppointments
  requestTransport
  makePayments
  manageAccess
}

enum RelationshipType {
  son
  daughter
  spouse
  sibling
  grandchild
  friend
  professionalCaregiver
  other
}

/// The central authorisation edge. Every patient-scoped query on the server
/// resolves through this table — a ride id is not a capability.
model PatientAccess {
  id           String             @id @default(uuid())
  userId       String
  patientId    String
  relationship RelationshipType
  permissions  FamilyPermission[]
  grantedAt    DateTime           @default(now())

  /// Null marks the organiser who created the patient record. They keep
  /// `manageAccess` unconditionally, or a family could lock itself out of its
  /// own patient with no recovery short of support.
  grantedByUserId String?
  revokedAt       DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([userId, patientId])
  @@index([patientId])
  @@map("patient_access")
}

/// Flagged in FOUNDATION §5 as an account-takeover vector, and treated as one.
///
/// Three properties do the work, and all three are enforced in the database
/// rather than only in the service:
///
///   - **Single-use**  — `acceptedAt`/`revokedAt`, checked inside the same
///     transaction that consumes the token.
///   - **Expiring**    — `expiresAt`, short by default.
///   - **Email-bound** — `email` must match the *verified* address of the
///     account accepting it. Without that binding, anyone holding the link
///     joins the family; the link then travels through forwarded mail, shared
///     inboxes and screenshots, and grants access to a patient's home address
///     and daily movements.
///
/// The token itself is stored only as a digest, so a database dump does not
/// contain a set of live invitations.
model PatientInvitation {
  id        String @id @default(uuid())
  patientId String
  tokenHash String @unique

  /// Lower-cased at write time; the uniqueness of an open invitation per
  /// address depends on it.
  email String

  relationship RelationshipType
  permissions  FamilyPermission[]

  invitedByUserId String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedReason    String?

  /// Rate-limits guessing and gives support something to look at. Bounded by
  /// the service, which revokes the invitation rather than letting it be
  /// hammered.
  attemptCount Int @default(0)

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedBy User?   @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([patientId])
  @@index([email])
  @@index([expiresAt])
  @@map("patient_invitations")
}

// ─── clinics ─────────────────────────────────────────────────────────────────

model Clinic {
  id             String    @id @default(uuid())
  name           String
  phone          String
  addressId      String
  entranceNotes  String?
  operatingNotes String?
  archivedAt     DateTime?

  /// IANA zone of this clinic. Appointments inherit it, and reminder offsets
  /// are measured against it — the appointment happens where the clinic is,
  /// not where the server is or where the family member happens to be sitting.
  timeZone String @default("America/New_York")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The clinic network that runs this site, when one has claimed it.
  ///
  /// Null for the overwhelming majority: a clinic record is created by a
  /// **family** typing where their relative's appointment is, and most of
  /// those will never have anybody from the clinic sign in. Claiming is what
  /// turns one into a portal, and it is deliberately not required for the
  /// clinic to work as an address.
  organizationId String?

  address      Address       @relation(fields: [addressId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  appointments Appointment[]

  @@index([organizationId])
  @@map("clinics")
}

// ─── appointments ────────────────────────────────────────────────────────────

enum AppointmentType {
  primaryCare
  specialist
  imaging
  labWork
  therapy
  dental
  vision
  followUp
  other
}

enum AppointmentStatus {
  draft
  scheduled
  confirmed
  patientPreparing
  transportationScheduled
  patientEnRoute
  patientArrived
  completed
  canceled
  missed
}

model Appointment {
  id                      String            @id @default(uuid())
  patientId               String
  clinicId                String
  startsAt                DateTime
  expectedDurationMinutes Int
  type                    AppointmentType
  status                  AppointmentStatus
  coordinationNotes       String?
  transportRequired       Boolean           @default(false)

  /// The label a person reads ("clinic time"), kept separate from the zone the
  /// scheduler computes in. They are not the same thing and conflating them is
  /// how a reminder fires at 3am.
  timeZoneLabel String @default("clinic time")

  /// IANA zone of the clinic, e.g. "America/New_York". `startsAt` is stored in
  /// UTC like everything else; this is what turns it back into the local wall
  /// time a reminder offset is measured against.
  timeZone String @default("America/New_York")

  /// Optimistic locking, per FOUNDATION §6.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The clinic confirming the patient is physically there.
  ///
  /// Distinct from the ride reaching `completed`, which only says a car
  /// arrived at the address. A family watching a screen has been told their
  /// relative was dropped off; this is somebody inside the building saying
  /// they came in.
  checkedInAt DateTime?

  /// The clinic saying the visit is over and a car may be sent.
  ///
  /// This is what a `flexibleReturn` ride has always been waiting for. Nobody
  /// knows when a cardiology follow-up will finish, which is why the return
  /// leg is booked without a time — and until now nothing could tell it the
  /// time had come.
  readyForReturnAt DateTime?

  patient   Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic    Clinic                     @relation(fields: [clinicId], references: [id])
  history   AppointmentStatusHistory[]
  rides     Ride[]
  reminders AppointmentReminder[]

  @@index([patientId])
  @@index([startsAt])
  @@map("appointments")
}

/// Append-only.
model AppointmentStatusHistory {
  id            String   @id @default(uuid())
  appointmentId String
  at            DateTime
  fromStatus    String
  toStatus      String
  actor         String
  reason        String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

/// One row per scheduled reminder, written in the same transaction as the
/// appointment that owns it.
///
/// The database row is the record of intent and the queue job is only the
/// timer. That split is deliberate: Redis is a cache and may be lost
/// (FOUNDATION §4), so on restart the scheduler re-reads this table and
/// re-enqueues anything still pending. If the queue were the only record, a
/// Redis flush would silently cancel every reminder in the system, and nobody
/// would find out until a patient missed an appointment.
model AppointmentReminder {
  id            String @id @default(uuid())
  appointmentId String

  /// Minutes before `Appointment.startsAt`.
  offsetMinutes Int

  /// Absolute UTC instant, resolved once against the appointment's IANA zone
  /// at scheduling time.
  scheduledFor DateTime

  sentAt      DateTime?
  cancelledAt DateTime?

  /// The BullMQ job id, so a rescheduled appointment can remove the timer it
  /// already set rather than firing both.
  jobId String?

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// One reminder per offset per appointment. The constraint is what makes
  /// rescheduling idempotent — a retried schedule cannot produce a second
  /// copy of the same reminder.
  @@unique([appointmentId, offsetMinutes])
  @@index([scheduledFor, sentAt])
  @@map("appointment_reminders")
}

// ─── transportation ──────────────────────────────────────────────────────────

model Vehicle {
  id                     String  @id @default(uuid())
  organizationId         String
  make                   String
  model                  String
  color                  String
  licensePlate           String
  isWheelchairAccessible Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  drivers      Driver[]

  @@index([organizationId])
  @@map("vehicles")
}

/// The lifecycle of a driver at an operator. Mirrors
/// src/domain/driver-status.ts, which is where the transition table lives.
///
/// `approved` is the **only** status that occupies a billable seat, and that
/// is the single definition — the alternative is a second boolean somebody has
/// to remember to keep in step, and an operator billed for drivers they
/// offboarded in March is the kind of error that ends a contract.
enum DriverStatus {
  invited
  pendingApproval
  approved
  suspended
  offboarded
}

model Driver {
  id String @id @default(uuid())

  /// The operator this driver works for. Required: a driver with no operator
  /// is a seat nobody is billed for, and an unbilled seat is the whole way the
  /// dispatch side of the fee model leaks.
  organizationId String

  /// First name and last initial only. The family needs to recognise the person
  /// at the kerb, not to be able to look them up.
  displayName  String
  rating       Float  @default(5)
  yearsDriving Int    @default(1)
  vehicleId    String

  status DriverStatus @default(invited)

  /// The account this person signs into the **driver app** with.
  ///
  /// Null until claimed, because the operator builds the roster before the
  /// driver has necessarily signed up — the same reason a driver starts as
  /// `invited` rather than approved.
  ///
  /// Unique globally, and that is a product decision rather than a
  /// convenience: assignment eligibility — "one passenger at a time" — is
  /// enforced per *driver row*. One human holding two driver rows at two
  /// operators would be two independently-eligible drivers, and could be sent
  /// to two overlapping pickups by two dispatchers, neither of whom can see
  /// the other's queue. Driving for two operators is a real thing and is
  /// deliberately not supported until that rule spans them.
  userId String? @unique

  /// The address the operator says this driver will sign up with.
  ///
  /// The claim is matched on it, and only ever against a **verified** address
  /// — otherwise registering with a driver's email would be enough to inherit
  /// their assignments, and with them a passenger's home address and phone
  /// number.
  invitedEmail String?

  accountLinkedAt DateTime?

  /// Whether the driver is working right now. A scheduling fact that changes
  /// several times a day, deliberately separate from `status`, which is the
  /// company saying whether this person may carry a passenger at all.
  onShift Boolean @default(false)

  approvedAt       DateTime?
  approvedByUserId String?
  suspensionReason String?

  /// When they stopped occupying a seat. Set alongside any move out of
  /// `approved`, and kept rather than deleted: "you were charged for eleven
  /// drivers in June" has to be answerable with eleven names, including the
  /// two who left in July.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id])
  approvedBy   User?             @relation("DriverApprover", fields: [approvedByUserId], references: [id])
  user         User?             @relation("DriverAccount", fields: [userId], references: [id])
  rides        Ride[]
  seatChanges  SeatLedgerEntry[]
  documents    DriverDocument[]

  @@index([organizationId, status])
  /// The claim lookup. Partial in spirit — most rows have no invited address —
  /// but scoped by organisation so it cannot become a way to ask "does this
  /// email drive for anyone".
  @@index([organizationId, invitedEmail])
  @@map("drivers")
}

/// What a driver has to hand in before anybody will let them carry a
/// passenger.
///
/// The list is short and every entry is a legal requirement rather than a
/// preference. Nothing here is optional and nothing else is collected: a
/// transport operator has no business holding a driver's passport because the
/// upload form happened to allow one.
enum DriverDocumentKind {
  driversLicence
  vehicleInsurance
  vehicleRegistration
  backgroundCheck
}

/// Where a document is in review.
///
/// `expired` is a status rather than a deletion, and that is the point of it:
/// an insurance certificate that lapsed in March has to stay answerable for
/// the rides that happened in February.
enum DriverDocumentStatus {
  /// A slot exists and the file has not arrived. Created when the upload is
  /// authorised, so an abandoned upload is visible as an empty slot rather
  /// than as nothing at all.
  awaitingUpload
  submitted
  approved
  rejected
  expired
}

/// One file a driver has submitted, and the decision made about it.
///
/// The **bytes are not here**. This row holds a key into object storage, and
/// every read of the file goes through a short-lived pre-signed URL minted for
/// one authorised person. A licence scan carries a home address, a date of
/// birth and a photograph — the three things this product otherwise refuses to
/// store — so it lives behind a URL that expires rather than behind a path
/// anybody who learns it can fetch forever.
model DriverDocument {
  id       String             @id @default(uuid())
  driverId String
  kind     DriverDocumentKind

  status DriverDocumentStatus @default(awaitingUpload)

  /// The object key. Contains no name, no licence number and no readable
  /// identifier — a bucket listing must not be a roster.
  storageKey String @unique

  contentType String
  byteSize    Int?

  /// Present only after the file arrives. Lets a re-upload of the identical
  /// file be recognised, and lets a stored object be checked against what was
  /// submitted.
  checksum String?

  /// When the document itself stops being valid — the date printed on the
  /// licence, not a retention deadline. Null for documents that do not expire.
  expiresAt DateTime?

  submittedAt DateTime?
  reviewedAt  DateTime?

  reviewedByUserId String?

  /// Required when rejecting. "Rejected" with no reason is a driver who
  /// re-uploads the same unreadable photograph three times.
  reviewNote String?

  /// Set when a renewal replaces this document. A superseded row is never
  /// deleted: "which certificate was in force on the 3rd of March" has to stay
  /// answerable after any number of renewals.
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver     Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id])

  /// One live document per kind per driver. A superseded one is kept — a
  /// renewal must not erase the certificate that covered last month's rides —
  /// so this is enforced in application code against the non-superseded row
  /// rather than by a constraint here.
  @@index([driverId, kind])
  @@index([status])
  @@map("driver_documents")
}

enum RideDirection {
  outbound
  returnTrip
}

/// Which of the two revenue lines paid for this ride's platform margin.
/// Stamped on the ride alongside the pricing rule version, so a payout can be
/// explained months after the fact.
enum PlatformFunding {
  /// The operator holds a per-driver subscription. The whole fare is theirs.
  operatorSubscription
  /// No subscription: the rule's basis points applied.
  perRide
}

/// Deliberately no `delayed` member: a driver stuck in traffic on the way to
/// pickup is still `driverEnRoute`. Delay is a flag on the ride, so it can be
/// raised and cleared without losing the state it must return to.
enum RideStatus {
  draft
  requested
  awaitingAssignment
  assigned
  driverAccepted
  driverEnRoute
  driverArrived
  passengerOnboard
  inProgress
  arrivedAtDestination
  completed
  canceled
  noShow
  reassignmentRequired
}

model Ride {
  id            String  @id @default(uuid())
  patientId     String
  appointmentId String?

  /// A round trip is two rides sharing this id, not one ride with two legs.
  roundTripGroupId String?

  direction            RideDirection
  pickupAddressId      String
  destinationAddressId String
  scheduledPickupAt    DateTime
  flexibleReturn       Boolean       @default(false)
  status               RideStatus
  wheelchairRequired   Boolean       @default(false)
  assistanceRequired   Boolean       @default(false)
  notesForDriver       String?
  driverId             String?

  isDelayed          Boolean @default(false)
  delayReason        String?
  cancellationReason String?

  // Price estimate, itemised. Integer cents throughout — money never touches a
  // float. Kept on the ride so a historical charge can always be explained.
  priceRuleVersion    String
  distanceMiles       Float
  durationMinutes     Int
  baseCents           Int
  distanceChargeCents Int
  timeChargeCents     Int
  totalCents          Int
  minimumApplied      Boolean @default(false)

  // Where the fare goes. Null until an operator is known, which is at driver
  // assignment and not at request: the family is quoted a total before anybody
  // has been dispatched, and who ends up carrying them decides the split
  // rather than the price.
  //
  // The operator is pinned here rather than read back through the driver,
  // because a reassignment changes the driver and must not silently move a
  // settled payout to a different company.
  platformFunding       PlatformFunding?
  platformFeeCents      Int?
  operatorPayoutCents   Int?
  settledOrganizationId String?

  // Last known position. Aged against `capturedAt` (when the device took the
  // reading), never against when the server received it.
  lastLatitude       Float?
  lastLongitude      Float?
  lastAccuracyMeters Float?
  lastCapturedAt     DateTime?
  etaMinutes         Int?

  /// Preview-only trip runner, standing in for the driver app and dispatch.
  /// Persisted so it survives an API restart and a browser refresh.
  simulationActive         Boolean @default(false)
  simulationElapsedSeconds Int     @default(0)

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment?         @relation(fields: [appointmentId], references: [id])
  pickup          Address              @relation("RidePickup", fields: [pickupAddressId], references: [id])
  destination     Address              @relation("RideDestination", fields: [destinationAddressId], references: [id])
  driver          Driver?              @relation(fields: [driverId], references: [id])
  operator        Organization?        @relation(fields: [settledOrganizationId], references: [id])
  surcharges      RideSurcharge[]
  events          RideEvent[]
  history         RideStatusHistory[]
  locationSamples RideLocationSample[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@map("rides")
}

model RideSurcharge {
  id          String @id @default(uuid())
  rideId      String
  label       String
  amountCents Int
  position    Int    @default(0)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@map("ride_surcharges")
}

/// Append-only.
model RideStatusHistory {
  id         String   @id @default(uuid())
  rideId     String
  at         DateTime
  fromStatus String
  toStatus   String
  actor      String
  reason     String?

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@map("ride_status_history")
}

/// The operational timeline the family reads back later.
model RideEvent {
  id          String   @id @default(uuid())
  rideId      String
  at          DateTime
  title       String
  detail      String?
  isException Boolean  @default(false)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@map("ride_events")
}

/// Sampled position history, for dispute resolution. Thirty-day retention,
/// enforced by the retention job — not by intention. The *live* position is the
/// denormalised `last*` columns on Ride; this table is the audit trail.
model RideLocationSample {
  id             String   @id @default(uuid())
  rideId         String
  latitude       Float
  longitude      Float
  accuracyMeters Float
  capturedAt     DateTime
  receivedAt     DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  /// Unique rather than merely indexed, and that is what makes a batch upload
  /// from the driver app's offline queue safe to retry: a device takes one
  /// reading per instant, so re-sending a batch whose response was lost
  /// inserts nothing the second time. Without it, every dropped response
  /// duplicates a stretch of somebody's journey in the dispute record.
  @@unique([rideId, capturedAt])
  @@map("ride_location_samples")
}

// ─── notifications ───────────────────────────────────────────────────────────

enum NotificationKind {
  appointmentCreated
  appointmentReminder
  appointmentChanged
  appointmentCanceled
  rideRequested
  driverAssigned
  driverEnRoute
  driverArrivingSoon
  driverArrived
  patientPickedUp
  patientArrived
  rideDelayed
  rideCompleted
  rideCanceled
  accessGranted
}

enum NotificationChannel {
  inApp
  email
  push
}

/// Bodies carry no patient name, clinic name, address or time. A phone on a
/// kitchen table is readable by whoever is in the room. Enforced by test.
model Notification {
  id            String           @id @default(uuid())
  userId        String
  kind          NotificationKind
  title         String
  body          String
  createdAt     DateTime         @default(now())
  readAt        DateTime?
  rideId        String?
  appointmentId String?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@map("notifications")
}

enum DeliveryStatus {
  pending
  sent
  failed
  suppressed
}

/// What actually happened on each channel, per notification.
///
/// Separate from `Notification` because "the family was told" and "the email
/// provider accepted it" are different facts, and a support conversation about
/// a missed ride needs both. `suppressed` is a first-class outcome, not a
/// failure: a user who turned email off did not have a delivery problem.
model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  status         DeliveryStatus      @default(pending)

  attemptedAt DateTime  @default(now())
  completedAt DateTime?

  /// Vendor message id where there is one — the thing to quote when asking an
  /// email provider what became of a message.
  providerRef String?

  /// A provider's own error text. Never the recipient address, never the body.
  failureReason String?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, attemptedAt])
  @@map("notification_deliveries")
}

/// Per-user, per-event, per-channel. Absent means "use the default for this
/// event kind" — storing a full matrix for every new user would mean a new
/// notification kind ships switched off for everyone who registered before it
/// existed.
model NotificationPreference {
  id      String              @id @default(uuid())
  userId  String
  kind    NotificationKind
  channel NotificationChannel
  enabled Boolean

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, channel])
  @@map("notification_preferences")
}

enum DevicePlatform {
  android
  ios
  web
}

enum AppTarget {
  family
  driver
  ops
}

/// FCM registration tokens.
///
/// `appTarget` is recorded because the driver app and the family app are
/// separate installs (D4) and a ride notification must not be pushed to the
/// wrong one. Tokens rotate on their own schedule, so `lastSeenAt` drives the
/// cleanup of ones no client has re-registered.
model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform
  appTarget AppTarget      @default(family)

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  /// Set when FCM reports the token as permanently gone (UNREGISTERED), so we
  /// stop paying to push to an app that has been uninstalled.
  invalidatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("device_tokens")
}

// ─── money ───────────────────────────────────────────────────────────────────

/// Prices are configurable records, never constants in code — so a historical
/// charge can always be explained by the rule that produced it.
model PricingRule {
  id                       String @id @default(uuid())
  version                  String @unique
  baseFareCents            Int
  perMileCents             Int
  perMinuteCents           Int
  minimumFareCents         Int
  wheelchairSurchargeCents Int
  assistanceSurchargeCents Int

  /// Our cut of a fare, in basis points, and **only** for operators who are
  /// not on a subscription. An operator paying per driver keeps the whole
  /// fare; see `settleFare` in src/domain/pricing.ts.
  platformFeeBps Int @default(1500)

  effectiveFrom DateTime
  active        Boolean  @default(true)

  @@map("pricing_rules")
}

// ─── subscriptions ───────────────────────────────────────────────────────────

/// The two sides of the marketplace that can hold a subscription.
enum BillingPayer {
  family
  dispatchOrganization
}

/// Monthly or annual, and nothing in between. Annual is a **separate plan
/// row** with its own price rather than a multiplier applied in code: the size
/// of the annual discount is a commercial decision, and a commercial decision
/// must not be a deploy.
enum BillingInterval {
  monthly
  annual
}

enum SubscriptionStatus {
  trialing
  active
  pastDue
  pendingCancellation
  canceled
  expired
}

/// Whoever is billed. One table for both sides, because "is this subscription
/// currently entitling anything" is one question and two implementations of it
/// would eventually disagree — with the disagreement being either a family
/// locked out of a live trip or an operator using a console they stopped
/// paying for.
///
/// Exactly one of `ownerUserId` and `organizationId` is set. Both carry a
/// unique constraint, so a household and an operator each have at most one
/// billing account and the "which account am I looking at" question has one
/// answer.
model BillingAccount {
  id    String       @id @default(uuid())
  payer BillingPayer

  /// Set for a family account: the organiser who pays. Null for an operator.
  ownerUserId    String? @unique
  /// Set for an operator account. Null for a family.
  organizationId String? @unique

  /// Where invoices and dunning go. Separate from the account email on
  /// purpose — the person who books the rides and the person who pays for
  /// them are frequently not the same person, and in an operator they never
  /// are.
  billingEmail String

  /// Stripe customer id. Null until Stage 4 wires the processor up: card data
  /// never touches this database, only the identifier — see ADR-0006.
  externalCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User?           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  invoices       Invoice[]
  payments       Payment[]

  @@map("billing_accounts")
}

/// A plan is a row. The catalogue is data, resolved server-side, and the app
/// renders whatever it is told — so a price change, a new tier or a
/// discontinued plan is an insert, not a release.
model SubscriptionPlan {
  id   String @id @default(uuid())
  /// Stable across price changes: `family-standard`, `dispatch-core`.
  code String

  /// Immutable price identity, stamped onto every period this plan bills — the
  /// same mechanism as `PricingRule.version` on a ride, and for the same
  /// reason: a charge from eight months ago must still be explicable to the
  /// person who paid it.
  version String

  payer       BillingPayer
  interval    BillingInterval
  name        String
  description String

  /// The fixed part. For a family plan it is the whole price.
  basePriceCents Int

  /// Drivers covered by the base price. Always 0 on a family plan — a
  /// household does not have seats.
  includedSeats Int @default(0)

  /// Strings, not an enum the code branches on in twenty places. The
  /// catalogue of valid values is the `Entitlement` union in
  /// src/domain/billing.ts, checked when a plan is written.
  entitlements String[]

  trialDays Int @default(0)

  /// How long a failed payment keeps entitling. Not zero, and the reason is
  /// specific: cutting live tracking off the instant a card expires blanks the
  /// map while somebody's mother is in a stranger's car.
  graceDays Int @default(7)

  active        Boolean  @default(true)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  seatTiers     SubscriptionPlanSeatTier[]
  subscriptions Subscription[]

  @@unique([code, interval, version])
  @@index([payer, active])
  @@map("subscription_plans")
}

/// One band of the graduated per-driver ladder. `upToSeats` is a total driver
/// count, inclusive; the last tier is unbounded (`null`), or every driver
/// above the top band would be free.
model SubscriptionPlanSeatTier {
  id             String @id @default(uuid())
  planId         String
  position       Int
  upToSeats      Int?
  unitPriceCents Int

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, position])
  @@map("subscription_plan_seat_tiers")
}

model Subscription {
  id               String @id @default(uuid())
  billingAccountId String
  planId           String

  status SubscriptionStatus

  /// Denormalised from the plan so "show me everyone renewing annually" does
  /// not need a join, and so the interval a period was billed at survives the
  /// plan being deactivated.
  interval BillingInterval

  /// Drivers this subscription bills for from the next renewal. Zero on a
  /// family subscription.
  seats Int @default(0)

  /// The highest seat count already charged for in the **current** period.
  ///
  /// Proration is measured against this rather than against `seats`, so an
  /// operator who drops from twelve drivers to ten and back to twelve inside
  /// one month is not billed twice for the same two seats. Reset to `seats` at
  /// every renewal, which is the moment a reduction actually takes effect.
  seatsPaidFor Int @default(0)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  trialEndsAt       DateTime?
  /// When the first payment failed. Drives the grace window; null unless
  /// `pastDue`.
  pastDueSince      DateTime?
  /// Cancellation is requested now and takes effect at `currentPeriodEnd`.
  /// Cancelling is not a refund.
  cancelRequestedAt DateTime?
  canceledAt        DateTime?

  /// Credit that outran a charge on an interval switch, spent down against
  /// renewals rather than refunded.
  carriedCreditCents Int @default(0)

  /// Optimistic locking, as on rides and appointments.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingAccount BillingAccount       @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan     @relation(fields: [planId], references: [id])
  periods        SubscriptionPeriod[]
  seatChanges    SeatLedgerEntry[]
  invoices       Invoice[]

  @@index([billingAccountId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Append-only. What was billed, at what driver count, under which plan
/// version — the row an invoice is reconstructed from.
///
/// The plan code, version and interval are **copied** rather than joined. A
/// plan row can be deactivated or superseded; the period has to keep saying
/// what it actually charged.
model SubscriptionPeriod {
  id             String @id @default(uuid())
  subscriptionId String
  sequence       Int

  startsAt DateTime
  endsAt   DateTime

  planCode    String
  planVersion String
  interval    BillingInterval

  seatsBilled     Int
  basePriceCents  Int
  seatChargeCents Int
  totalCents      Int

  /// The itemisation, exactly as it was quoted. Shown on the invoice, so an
  /// operator can see which band their twenty-first driver landed in — a bill
  /// nobody can check is a bill somebody eventually disputes.
  lines Json

  closedAt  DateTime?
  createdAt DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice?

  @@unique([subscriptionId, sequence])
  @@map("subscription_periods")
}

enum SeatChange {
  granted
  released
}

/// Append-only ledger of driver seats: the audit trail behind an invoice line.
///
/// Without it, "why were we billed for eleven drivers" is answerable only from
/// the current state of the `drivers` table, which by then has changed.
model SeatLedgerEntry {
  id             String     @id @default(uuid())
  subscriptionId String
  driverId       String
  change         SeatChange
  at             DateTime   @default(now())
  actorUserId    String?

  /// The seat count after this change, so a period can be reconstructed
  /// without replaying the whole ledger.
  seatsAfter Int

  /// Charged immediately for the remainder of the period on a grant. Zero on a
  /// release — a released seat stays usable until the period that paid for it
  /// ends, and is not refunded.
  prorationCents Int @default(0)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([subscriptionId, at])
  @@index([driverId])
  @@map("seat_ledger_entries")
}

// ─── money movement ──────────────────────────────────────────────────────────

/// A card on file, as an identifier and four digits — never a number.
///
/// Card data does not enter this database and no code path here can accept
/// one: the processor tokenises it in the client and we store the token. What
/// is kept beside it is only what a person needs to recognise which card is
/// being charged, because "your payment failed" against an account holding two
/// cards and naming neither is a support call rather than a fix.
model PaymentMethod {
  id               String @id @default(uuid())
  billingAccountId String

  /// The processor's token. The only handle we have on the card, by design.
  externalId String @unique

  /// Display only. `brand` and `last4` identify the card to its owner;
  /// `expMonth`/`expYear` let us warn before it lapses rather than after.
  brand    String
  last4    String
  expMonth Int
  expYear  Int

  /// Which card renewals are charged against. At most one per account, held
  /// by a partial unique index rather than by convention — two defaults is a
  /// question with two answers, and the answer decides whose card is charged.
  isDefault Boolean @default(false)

  /// Set when the processor reports the card is gone. Kept rather than
  /// deleted, so a historical payment still names the card that paid it.
  detachedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([billingAccountId, detachedAt])
  @@map("payment_methods")
}

enum InvoiceReason {
  /// The recurring charge for one `SubscriptionPeriod`.
  subscriptionPeriod
  /// Drivers added mid-period, charged for the remainder of it.
  seatProration
  /// Monthly ⇄ annual, where the new period's price outran the credit.
  intervalSwitch
}

enum InvoiceStatus {
  /// Issued and owed.
  open
  paid
  /// Dunning ran out, or the card will never work. Owed but not pursued here.
  uncollectible
  /// Withdrawn. Never owed, and distinct from `uncollectible` on purpose —
  /// one is our mistake and the other is theirs, and an invoice that conflates
  /// them cannot be reconciled by anybody.
  void
}

/// What was charged, why, and whether it was paid.
///
/// Separate from `SubscriptionPeriod` rather than folded into it, because they
/// answer different questions and change at different times. A period says
/// what the plan cost for a span of days and is written once. An invoice says
/// what somebody owes and is written against a period, a seat proration or an
/// interval switch — three sources, one collection process. Merging them would
/// mean a failed payment mutating the record of what the plan cost.
model Invoice {
  id               String  @id @default(uuid())
  billingAccountId String
  subscriptionId   String?

  /// One invoice per billed period. Null on a proration or a switch, and
  /// unique when set so a retried sweep cannot bill a period twice.
  periodId String? @unique

  reason InvoiceReason
  status InvoiceStatus @default(open)

  /// Human-quotable, from a database sequence: an invoice somebody rings up
  /// about has to be findable by the number printed on it. Generated by the
  /// database so two concurrent sweeps cannot mint the same number.
  number String @unique @default(dbgenerated("('CB-' || lpad(nextval('invoice_number_seq')::text, 6, '0'))"))

  currency String @default("usd")

  subtotalCents      Int
  /// Carried credit spent against this invoice — see `carriedCreditCents`.
  creditAppliedCents Int @default(0)
  totalCents         Int
  amountPaidCents    Int @default(0)

  /// The itemisation as it was quoted, copied rather than joined. A plan can
  /// be superseded; the invoice has to keep saying what it actually charged.
  lines Json

  issuedAt DateTime  @default(now())
  dueAt    DateTime
  paidAt   DateTime?
  voidedAt DateTime?

  /// Dunning state. Held on the invoice rather than the subscription because
  /// the thing being retried is a charge, and an account can have more than
  /// one outstanding at a time.
  attemptCount    Int       @default(0)
  firstFailedAt   DateTime?
  nextAttemptAt   DateTime?
  lastFailureCode String?

  externalInvoiceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  period         SubscriptionPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  payments       Payment[]
  refunds        Refund[]

  @@index([billingAccountId, issuedAt])
  @@index([status, nextAttemptAt])
  @@map("invoices")
}

enum PaymentStatus {
  /// Submitted, outcome not yet known. Where a payment needing the cardholder
  /// to authenticate sits.
  pending
  succeeded
  failed
  refunded
}

/// One attempt to move money. Append-only: a retry is a new row.
///
/// Keeping every attempt rather than a status on the invoice is what makes a
/// dispute answerable — "we tried on the 2nd, the 4th and the 9th, and here is
/// what the issuer said each time" — and it is what stops a duplicate webhook
/// being mistaken for a second payment.
model Payment {
  id               String  @id @default(uuid())
  invoiceId        String
  billingAccountId String
  paymentMethodId  String?

  /// Attempts already made on this invoice, including this one.
  attempt Int

  amountCents Int
  currency    String        @default("usd")
  status      PaymentStatus @default(pending)

  /// The processor's code and message, kept verbatim. `failureCode` is what
  /// `classifyDecline` reads to decide whether another attempt can succeed.
  failureCode    String?
  failureMessage String?

  /// The processor's identifier for this attempt, and the idempotency key we
  /// submitted it under. Unique, so the same attempt replayed against the
  /// processor cannot become two rows here.
  externalPaymentId String? @unique
  idempotencyKey    String  @unique

  createdAt DateTime  @default(now())
  settledAt DateTime?

  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  refunds        Refund[]

  @@index([invoiceId, createdAt])
  @@index([billingAccountId, createdAt])
  @@map("payments")
}

/// Every processor event we have already handled.
///
/// Webhooks arrive more than once and out of order — both are documented
/// behaviour, not failure. Without this table a redelivered
/// `payment_intent.succeeded` marks an invoice paid twice, and the second
/// pass credits an account that paid once. The unique external id is the whole
/// defence, and it is a database constraint rather than a check-then-write so
/// that two workers racing the same redelivery cannot both pass the check.
model ProcessorEvent {
  id String @id @default(uuid())

  /// The processor's event id.
  externalEventId String @unique
  type            String

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  /// Why an event was not acted on, where it was not. An event for an object
  /// we do not know about is normal and is recorded rather than dropped.
  skippedReason String?

  @@index([type, receivedAt])
  @@map("processor_events")
}

// ─── audit ───────────────────────────────────────────────────────────────────

/// Append-only: no update or delete path exists in the application.
///
/// Changed **field names** are recorded; changed **values** are not. Knowing
/// that a phone number was edited is what an investigation needs; storing the
/// old and new number would make the audit log a second copy of the data it
/// exists to protect.
enum RefundStatus {
  pending
  succeeded
  failed
}

/// Money going back, and who decided it should.
///
/// Refunds were **reconciled** before this existed: one issued in the
/// processor's console landed against its invoice through the webhook, and
/// there was deliberately no endpoint to start one without an approval surface
/// behind it. This is that surface. The row exists before the processor is
/// called, for the same reason a payment attempt does — a refund that succeeded
/// at the processor and failed to record here is money that left the business
/// with nothing to explain it.
model Refund {
  id        String @id @default(uuid())
  invoiceId String
  paymentId String

  /// Never more than the payment. Partial refunds are ordinary — a ride was
  /// half completed, a surcharge was applied in error.
  amountCents Int
  currency    String @default("usd")

  /// Required. A refund with no reason is an unexplained credit in a ledger
  /// somebody will have to justify to an accountant a quarter later.
  reason String

  status RefundStatus @default(pending)

  externalRefundId String? @unique

  /// Submitted to the processor under this key, so a retry after a lost
  /// response cannot refund twice.
  idempotencyKey String @unique

  failureMessage String?

  /// Who authorised it. Not nullable: every refund has a person behind it.
  requestedByUserId String

  createdAt DateTime  @default(now())
  settledAt DateTime?

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RefundRequester", fields: [requestedByUserId], references: [id])

  @@index([invoiceId, createdAt])
  @@map("refunds")
}

/// A switch, and how far it is turned.
///
/// Keyed by a string rather than an enum on purpose: a flag's whole value is
/// that it can be added without a migration and removed without one. The cost
/// is that a typo is a flag that is simply off, which is the safe direction.
model FeatureFlag {
  key         String @id
  description String

  /// The master switch. False means off for everybody regardless of rollout.
  enabled Boolean @default(false)

  /// Nought to a hundred. Applied to a stable hash of the subject, so a given
  /// user is on the same side of the line on every request — a flag that
  /// flipped per request would be worse than one that is simply off.
  rolloutPercent Int @default(0)

  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  updatedBy User? @relation("FlagEditor", fields: [updatedByUserId], references: [id])

  @@map("feature_flags")
}

// ─── caregiver marketplace (Stage 5A) ────────────────────────────────────────
//
// **Companion care, not clinical care.** Sitting with somebody, helping them to
// a door, being in the room. Nothing here is a nurse, and nothing in this
// schema records a treatment, a medication or a condition — the same absence
// the rest of the model keeps.
//
// The hard rule this whole section is written around: **a platform check is
// not a safety guarantee.** CareBridge records that identity was confirmed and
// that a background check was run, with its date and its provider. It does not
// say the person is safe, it does not rank by it, and the copy that reaches a
// family says exactly that.

enum CaregiverStatus {
  /// Applied. Visible to nobody.
  applied
  /// Identity confirmed and a check on file. Bookable.
  verified
  /// Temporarily stopped — a complaint under review, a lapsed check.
  suspended
  /// Gone. Terminal, and the record stays so past bookings still name
  /// somebody.
  offboarded
}

model Caregiver {
  id     String @id @default(uuid())
  userId String @unique

  /// First name and last initial, like a driver. A family needs to recognise
  /// the person at the door, not to be able to look them up.
  displayName String

  /// Written by the caregiver. Never contains a qualification claim the
  /// platform has not checked — moderated on write.
  bio String

  yearsExperience Int      @default(0)
  languages       String[] @default([])

  /// Integer cents per hour. Money never touches a float.
  hourlyRateCents Int

  /// How far they will travel, from the area they work out of.
  serviceRadiusMiles Int    @default(10)
  serviceAreaCity    String
  serviceAreaState   String

  status CaregiverStatus @default(applied)

  /// When identity was confirmed, and when a background check was last run.
  ///
  /// Two separate dates because they are two separate things, and because "a
  /// check was run in 2019" is a materially different statement from "a check
  /// was run last month". Both are shown to a family with their dates, so the
  /// family judges rather than the platform.
  identityVerifiedAt DateTime?
  backgroundCheckAt  DateTime?
  backgroundCheckRef String?
  suspensionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation("CaregiverAccount", fields: [userId], references: [id], onDelete: Cascade)
  availability CaregiverAvailability[]
  bookings     CaregiverBooking[]
  reviews      CaregiverReview[]

  @@index([status, serviceAreaState, serviceAreaCity])
  @@map("caregivers")
}

/// A recurring weekly window somebody is willing to work.
///
/// Weekly rather than a list of dates: a caregiver who has to re-enter their
/// availability every Sunday stops doing it by the third week, and a
/// marketplace whose availability is stale is a marketplace of dead ends.
model CaregiverAvailability {
  id          String @id @default(uuid())
  caregiverId String

  /// 1 = Monday, 7 = Sunday, matching ISO-8601 and Luxon.
  weekday Int

  /// Minutes from midnight, in the caregiver's own zone.
  startMinute Int
  endMinute   Int

  timeZone String @default("America/New_York")

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([caregiverId, weekday])
  @@map("caregiver_availability")
}

enum BookingStatus {
  /// The family asked. The caregiver has not answered.
  requested
  confirmed
  /// The caregiver arrived and said so.
  inProgress
  completed
  cancelledByFamily
  cancelledByCaregiver
  /// Nobody came. Distinct from a cancellation, because it is the outcome a
  /// family is owed an explanation for.
  noShow
}

/// One engagement.
model CaregiverBooking {
  id          String @id @default(uuid())
  caregiverId String
  patientId   String

  /// Who arranged it, and therefore who is charged.
  bookedByUserId String

  startsAt DateTime
  endsAt   DateTime

  status BookingStatus @default(requested)

  /// The rate agreed **at booking**, not today's. A caregiver raising their
  /// price must not re-price an engagement somebody has already agreed to —
  /// the same rule the ride pricing follows.
  hourlyRateCents Int

  /// Basis points of the total, stamped at booking for the same reason.
  commissionBasisPoints Int

  /// Set when the work actually happens. The charge is computed from these
  /// rather than from the booked window: a visit that ran twenty minutes over
  /// is twenty minutes of somebody's afternoon.
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  /// Written at completion, from the checked times.
  billableMinutes      Int?
  totalCents           Int?
  platformFeeCents     Int?
  caregiverPayoutCents Int?

  cancellationReason String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver        @relation(fields: [caregiverId], references: [id])
  patient   Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bookedBy  User             @relation("BookingRequester", fields: [bookedByUserId], references: [id])
  review    CaregiverReview?
  dispute   BookingDispute?

  @@index([caregiverId, startsAt])
  @@index([patientId, startsAt])
  @@index([status])
  @@map("caregiver_bookings")
}

/// A rating, tied to one booking.
///
/// One per booking, and only from a booking that actually happened. Both are
/// enforced: a marketplace where anybody can rate anybody is a marketplace
/// with a reputation attack in it, and one where a family can rate a visit
/// that never took place is worse.
model CaregiverReview {
  id          String @id @default(uuid())
  bookingId   String @unique
  caregiverId String

  /// One to five. Stored as an integer because half-stars are a display
  /// decision and averaging them is a different problem.
  rating Int

  comment String?

  authorUserId String

  createdAt DateTime @default(now())

  booking   CaregiverBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  caregiver Caregiver        @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  author    User             @relation("ReviewAuthor", fields: [authorUserId], references: [id])

  @@index([caregiverId, createdAt])
  @@map("caregiver_reviews")
}

enum DisputeStatus {
  open
  /// Somebody at CareBridge has looked and decided.
  resolved
  /// Withdrawn by whoever raised it.
  withdrawn
}

enum DisputeOutcome {
  /// The charge stands.
  upheld
  /// Refunded in part or in whole.
  refunded
  /// No charge was made and none will be.
  waived
}

/// A disagreement about an engagement.
///
/// Deliberately a first-class row rather than a support email. A dispute
/// decides whether money moves and whether somebody keeps working here, and
/// both have to be answerable months later with who decided and why.
model BookingDispute {
  id        String @id @default(uuid())
  bookingId String @unique

  raisedByUserId String
  reason         String

  status  DisputeStatus   @default(open)
  outcome DisputeOutcome?

  /// Required when resolving. A decision with no reasoning is one nobody can
  /// defend when the same question is asked again.
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())

  booking    CaregiverBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy   User             @relation("DisputeRaiser", fields: [raisedByUserId], references: [id])
  resolvedBy User?            @relation("DisputeResolver", fields: [resolvedByUserId], references: [id])

  @@index([status, createdAt])
  @@map("booking_disputes")
}

model AuditLog {
  id            String   @id @default(uuid())
  at            DateTime @default(now())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  correlationId String?
  ip            String?
  userAgent     String?
  changedFields String[]

  @@index([actorUserId, at])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// A request that must not be performed twice.
///
/// The failure this exists for is ordinary: a family taps "Request transport",
/// the response is lost to a dropped connection, the app retries, and a second
/// car is booked for the same appointment. Nothing in the ride state machine
/// can catch that — both requests are individually legal.
///
/// The row is claimed *before* the handler runs, and the unique constraint on
/// (userId, key) is what makes the claim atomic: two concurrent retries race
/// to insert, exactly one wins, and the loser is told the request is already
/// in progress rather than being allowed to duplicate it.
///
/// Keyed by user as well as key, so one client's chosen key cannot collide
/// with — or read — another's.
model IdempotencyRecord {
  id       String @id @default(uuid())
  userId   String
  /// Client-supplied. Opaque to us, and never logged: a client is free to put
  /// something meaningful in it.
  key      String
  /// Method and path. The same key on a different endpoint is a client bug,
  /// and treating it as a replay would return the wrong body entirely.
  endpoint String

  /// SHA-256 of the request body. A replay with a *different* body is not a
  /// retry; it is two different intentions sharing a key, and it is refused
  /// rather than silently answered with the first one's result.
  requestHash String

  /// Null until the handler returns. A row in that state is an in-flight
  /// request, which is what lets a concurrent retry be refused.
  responseStatus Int?
  responseBody   Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
