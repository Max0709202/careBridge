{
  "extends": "@carebridge/typescript-config/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    // Explicit, so the layout of `dist` does not change depending on which
    // files happen to be included: `dist/src/main.js`, `dist/prisma/seed.js`.
    "rootDir": "./",
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "declaration": false
  },
  "include": ["src/**/*", "prisma/seed.ts", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
