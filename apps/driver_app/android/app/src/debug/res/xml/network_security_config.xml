<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP, for local development only.

  This file exists in src/debug and src/profile and deliberately not in
  src/main: a release build of the driver app must never be able to send a
  driver's credentials or a patient's pickup address over plaintext HTTP, and
  the way to guarantee that is for the permission to be absent from the
  release manifest entirely rather than switched off inside it.

  From targetSdk 28 Android denies cleartext by default, which is why
  `http://10.0.2.2:3001` failed with the app's generic "We could not reach
  CareBridge" — the socket was refused by policy, not by the network. Only the
  three addresses that mean "the machine running the API" are listed:

    10.0.2.2   the Android emulator's alias for the host's loopback
    localhost  ) a physical handset reaches the host over the LAN, so these two
    127.0.0.1  ) only matter for adb reverse-forwarded ports

  A LAN address for a real device is deliberately not here. Adding one means
  writing a developer's local subnet into the repository, and the same result
  is available per-machine with `adb reverse tcp:3001 tcp:3001`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
