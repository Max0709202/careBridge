{
  "name": "carebridge",
  "version": "0.2.0",
  "private": true,
  "description": "CareBridge — one place to arrange an elderly relative's appointment and the ride to it.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @carebridge/api build",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:integration": "pnpm --filter @carebridge/api test:integration",
    "openapi": "pnpm --filter @carebridge/api openapi:emit",
    "dart:api": "node scripts/generate-dart-client.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.4.2"
  },
  "pnpm": {
    "//": "class-validator 0.15 is API-compatible with the ^0.14 range @nestjs/mapped-types declares; the package simply has not widened it. Silenced deliberately rather than left as permanent install noise that trains everyone to ignore peer warnings.",
    "peerDependencyRules": {
      "allowedVersions": {
        "class-validator": "0.15"
      }
    }
  }
}
